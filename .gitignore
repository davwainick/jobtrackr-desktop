.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# --- Application data (DB lives in user data dir, but ignore stray local copies) ---
*.db
*.sqlite
*.sqlite3
jobtrackr.db

# --- Editor / IDE ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- Emacs ---
\#*\#
.\#*
*.elc

